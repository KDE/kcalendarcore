#: exceptions.cpp:74
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Load Error"
msgstr "ჩატვირთვის შეცდომა"

#: exceptions.cpp:76
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Save Error"
msgstr "შენახვის შეცდომა"

#: exceptions.cpp:78
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Parse Error in libical"
msgstr "დამუშავების შეცდომა libical-ში"

#: exceptions.cpp:80
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Parse Error in the kcalcore library"
msgstr "დამუშავების შეცდომა ბიბლიოთეკაში kcalcore"

#: exceptions.cpp:82
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "No calendar component found."
msgstr "კალენდარის კომპონენტი ვერ ვიპოვე."

#: exceptions.cpp:84 exceptions.cpp:104
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Expected iCalendar, got vCalendar format"
msgstr "მოველოდი iCalendar-ს, მივიღე vCalendar-ის ფორმატი"

#: exceptions.cpp:86
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "iCalendar Version 2.0 detected."
msgstr "აღმოჩენილია iCalendar v2.0."

#: exceptions.cpp:88 exceptions.cpp:106
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Expected iCalendar, got unknown format"
msgstr "მოველოდი iCalendar-ს, მივიღე უცნობი ფორმატი"

#: exceptions.cpp:90
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Restriction violation"
msgstr "შეზღუდვის დარღვევა"

#: exceptions.cpp:92
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "No writable resource found"
msgstr "ჩაწერადი რესურსი აღმოჩენილი არაა"

#: exceptions.cpp:95
#, qt-format
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Error saving to '%1'."
msgstr "'%1'-ში შენახვის შეცდომა."

#: exceptions.cpp:98
#, qt-format
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Could not save '%1'"
msgstr "%1-ის შენახვის შეცდომა"

#: exceptions.cpp:100
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "libical error"
msgstr "libical-ის შეცდომა"

#: exceptions.cpp:102
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "No VERSION property found"
msgstr "თვისება VERSION აღმოჩენილი არაა"

#: exceptions.cpp:108
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Object is not a freebusy, event, todo or journal"
msgstr "ობიექტი თავისუფალი/დაკავებული, მოვლენა, გასაკეთებელი ან ჟურნალი არაა"

#: exceptions.cpp:110
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Message text is empty, unable to parse into a ScheduleMessage"
msgstr "შეტყობინების ტექსტი ცარიელია, ScheduleMessage-ში გადაყვანა შეუძლებელია"

#: exceptions.cpp:112
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "icalparser is unable to parse message text into a ScheduleMessage"
msgstr ""
"icalparser-ს არ შეუძლია, შეტყობინების ტექსტი ScheduleMessage-ში გადაიყვანოს"

#: exceptions.cpp:114
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Message does not contain ICAL_METHOD_PROPERTY"
msgstr "შეტყობინება ICAL_METHOD_PROPERTY-ს არ შეიცავს"
