#: exceptions.cpp:110
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "Message text is empty, unable to parse into a ScheduleMessage"
msgstr ""
"El text del missatge està buit, no s'ha pogut analitzar en un "
"«ScheduleMessage»"

#: exceptions.cpp:112
msgctxt "KCalendarCore::ExceptionPrivate|@item"
msgid "icalparser is unable to parse message text into a ScheduleMessage"
msgstr ""
"«icalparser» no ha pogut analitzar el text del missatge en un "
"«ScheduleMessage»"

#: exceptions.cpp:114
